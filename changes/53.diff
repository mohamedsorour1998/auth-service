def login():
+    # Get client's IP address for rate limiting
+    client_ip = request.remote_addr
+    
+    # Apply rate limiting if Redis is available
+    if redis_client and client_ip:
+        rate_key = f'login_attempts:{client_ip}'
+        
+        # Get current attempt count
+        current_attempts = redis_client.get(rate_key)
